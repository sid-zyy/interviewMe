{
  "manifest_version": 3,
  "name": "interviewMe — AI Interview Practice",
  "version": "0.2.0",
  "description": "Practice explaining coding problems out loud to an AI interviewer on LeetCode, NeetCode, HackerRank, Codeforces, GeeksforGeeks, CodeChef and AtCoder.",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "https://neetcode.io/*",
    "https://www.hackerrank.com/*",
    "https://codeforces.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://www.codechef.com/*",
    "https://atcoder.jp/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*",
        "https://neetcode.io/*",
        "https://www.hackerrank.com/*",
        "https://codeforces.com/*",
        "https://www.geeksforgeeks.org/*",
        "https://www.codechef.com/*",
        "https://atcoder.jp/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open interviewMe",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
