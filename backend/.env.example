# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# Optional model override
# GEMINI_MODEL=gemini-flash-latest

# --- Whisper speech-to-text --------------------------------------------------
# Groq hosts Whisper large-v3-turbo on a free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Or use OpenAI's whisper-1 instead (paid)
# OPENAI_API_KEY=
# Force a provider ("groq" | "openai"); otherwise picked from whichever key is set
# WHISPER_PROVIDER=groq
# WHISPER_MODEL=whisper-large-v3-turbo

# Port the backend listens on
PORT=8787

# Comma-separated list of allowed origins for CORS.
# The extension's origin looks like: chrome-extension://<extension-id>
ALLOWED_ORIGINS=chrome-extension://replace-with-your-extension-id
